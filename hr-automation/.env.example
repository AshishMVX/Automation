# Copy this file to .env and fill in your values
# These are also set as environment variables on Vercel / Netlify

# Password for the HR Portal login page
VITE_HR_PASSWORD=mervix2024

# Your n8n webhook URL (can also be set inside the app's Settings tab)
VITE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-path

# Google OAuth 2.0 Client ID — enables "Create Google Meet" button (optional)
# Get this from Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=
